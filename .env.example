# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# PostgreSQL Connection Strings
# Async driver for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/support_ai_db
# Sync driver for Alembic migrations
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/support_ai_db

# Security & JWT Authentication
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=support-ai-backend
JWT_AUDIENCE=support-ai-services